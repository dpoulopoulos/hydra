# ===============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ===============================================================================
# Copy this file to .env in this directory and update the values for your
# environment. DO NOT commit .env to version control - it contains sensitive
# credentials.
#
# For local development, the default values below should work out of the box.
# For production/staging, update all "changethis" values with secure credentials.
# ===============================================================================

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="hydra"
PROJECT_ID="Hydra"

# Hosts
BACKEND_HOST=http://localhost:8000
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# IMPORTANT: Generate a secure random string for SECRET_KEY in production.
# This is used for JWT token signing. If changed, all users will be logged out.
# Leaving it unset only works locally, where a per-process key is generated:
# staging and production refuse to start without one.
# Generate with: openssl rand -hex 32
SECRET_KEY=changethis

# First superuser, created by the initial_data script.
FIRST_SUPERUSER=admin@example.com
# IMPORTANT: Change this password in production!
FIRST_SUPERUSER_PASSWORD=changethis

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=changethis

# Emails. Leave EMAILS_FROM_EMAIL empty to disable email sending.
#
# EMAIL_PROVIDER picks how mail leaves the app:
#   smtp   - talk to a mail server. Needs SMTP_HOST. This is what the local
#            mail catcher offers, so it is the default.
#   resend - post to the Resend HTTPS API. Needs RESEND_API_KEY. Use this where
#            outgoing SMTP is blocked, which is the case on Railway below the
#            Pro plan.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=

SMTP_HOST=mailcatcher
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=

# Token lifetimes, in hours.
SESSION_TOKEN_EXPIRE_HOURS=192
EMAIL_PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
HOUSEHOLD_INVITE_TOKEN_EXPIRE_HOURS=168

# Market data, for the investments section.
#
# MARKET_DATA_PROVIDER picks where prices come from:
#   eodhd - EODHD, with a key that is free from https://eodhd.com/register. The
#           one free plan checked that quotes European listings as well as US
#           ones. Read MARKET_DATA_CACHE_HOURS below before using it: the free
#           plan allows twenty API calls a day and charges one per holding.
#   yahoo - Yahoo Finance's public endpoints. No key, but they are not a
#           supported API and they rate limit hard: a handful of requests from
#           one address earns a ban across every endpoint at once. Kept as an
#           escape hatch rather than recommended.
#   none  - switched off. Instruments and trades are still recorded by hand, and
#           a position is simply not valued.
MARKET_DATA_PROVIDER=eodhd
EODHD_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=10

# How long a fetched price is reused before the provider is asked again.
#
# This is a budget, not a performance setting. EODHD counts one API call per
# holding rather than per request, so refreshing five holdings spends five of a
# free plan's twenty daily calls. Inside this window a refresh is answered from
# the database and costs nothing, which is what makes the button safe to press.
#
# Raise it if the daily budget runs out. Five holdings at two hours can spend
# every call by mid-afternoon; at six hours they cannot.
MARKET_DATA_CACHE_HOURS=2

# Exchange rates come from Frankfurter, which is free, needs no key and
# publishes the European Central Bank's daily rates. Keeping rates off the
# metered provider means the whole quote budget goes to quotes.

# Frontend: where the dev server proxies /api. Only needed if the backend
# is not on port 8000.
# VITE_API_TARGET=http://localhost:8001
