# Serves the built web app in production, and forwards the API calls to the
# backend over the private network.
#
# The browser therefore sees a single origin for both the pages and the API,
# which is what the generated client expects: it sends relative URLs, and no
# cross-site request is ever made, so CORS never comes into it.

{
	# No admin API and no config on disk: neither is any use in a container
	# that is replaced on every deploy.
	admin off
	persist_config off
	# The platform terminates TLS in front of this server, so Caddy must not
	# try to obtain a certificate of its own.
	auto_https off
	log {
		format json
	}
	servers {
		# Trust the platform's proxy, so the client IP in the logs is the
		# visitor's and not the proxy's.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# The platform assigns the port and passes it in.
:{$PORT:8080} {
	log {
		format json
	}

	# The session token is kept in localStorage, where any script running on
	# this origin can read it, so the browser's own controls over what may run
	# are the thing standing between an injected script and the token. They are
	# configured here, and nowhere else.
	#
	# Everything the app loads is served from this origin: the bundles and the
	# fonts under /static, the API under /api. The policy is therefore almost
	# entirely 'self'.
	#
	# Scripts take one thing besides: 'wasm-unsafe-eval', without which a
	# browser compiles no WebAssembly module at all. The income vault stretches
	# the PIN that guards the client names with Argon2id, which is a WebAssembly
	# module from hash-wasm, so without this the vault can never be opened and
	# the names stay ciphertext. It is not 'unsafe-eval': it permits no eval and
	# no new Function, only the compilation of a module -- one this origin
	# served, since script-src is otherwise 'self'. See frontend/README.md.
	#
	# Styles are the one exception, and only half of one. The UI components set
	# style attributes as they render, with values computed at render time, so
	# style-src-attr has to allow them. A whole <style> element is a different
	# thing, and style-src-elem takes only this origin and the nonce below, so
	# an injected stylesheet is refused. The plain style-src is the fallback
	# for browsers that implement neither of the two, and says what it used to.
	#
	# The nonce is this request's id, which is a random UUID, and the same
	# value is rendered into the meta tag in index.html by the templates
	# directive further down. A component that builds a stylesheet as it runs
	# reads it from there; see src/lib/csp-nonce.ts.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'nonce-{http.request.uuid}'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		# Password reset, email verification and household invite links all put
		# a single use token in the query string. Sending no referrer keeps
		# that URL out of anyone else's logs.
		Referrer-Policy "no-referrer"
		# frame-ancestors already covers this for current browsers; the older
		# header costs a line and covers the rest.
		X-Frame-Options "DENY"
		# The platform terminates TLS in front of this server, so nothing else
		# here asserts HSTS.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Nothing gains from advertising the server and its version.
		-Server
	}

	# The API, and the images the emails point at, both live on the backend.
	handle /api/* {
		reverse_proxy {$BACKEND_ORIGIN}
	}

	handle /assets/* {
		reverse_proxy {$BACKEND_ORIGIN}
	}

	handle {
		root * /srv
		encode gzip
		# The entry page is the only template: it carries this request's nonce,
		# which the policy above names. Nothing else served here holds a
		# placeholder, and the bundles are not HTML, so nothing else is
		# rendered.
		templates
		# Client side routing: a path that is not a file on disk is still a
		# page of the app, so the app itself has to answer for it.
		try_files {path} /index.html
		file_server
	}
}
